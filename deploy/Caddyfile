{
	admin off
	auto_https off
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}

	@authorized header Authorization "Bearer {$MCP_BEARER_TOKEN}"
	handle @authorized {
		reverse_proxy zepp:8000 {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}

	handle {
		respond "Unauthorized" 401
	}
}
